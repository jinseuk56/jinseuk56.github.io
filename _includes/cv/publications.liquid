{% comment %}
  Site-specific CV publication renderer. The rendered CV keeps the complete author
  list, author-role markers, and the full DOI visible without duplicating a PDF-only
  citation format.
{% endcomment %}

<p class="cv-publication-key"><sup>†</sup> first or co-first author; <sup>*</sup> corresponding author.</p>
{% assign current_year = '' %}
<div class="cv-record-years">
  {% for entry in entries %}
    {% assign entry_year = entry.releaseDate | default: entry.date | split: '-' | first %}
    {% if entry_year != current_year %}
      {% unless current_year == '' %}
        </ul>
      {% endunless %}
      <h4 class="cv-record-year">{{ entry_year }}</h4>
      <ul class="card-text font-weight-light list-group list-group-flush cv-record-list">
      {% assign current_year = entry_year %}
    {% endif %}
    <li class="list-group-item">
      <h6 class="title">{{ entry.title }}</h6>
      {% assign author_markup = entry.authors | replace: 'J. Ryu', '<strong><u>J. Ryu</u></strong>' | regex_replace: '([*†]+)', '<sup>\1</sup>' %}
      <p class="mb-1">{{ author_markup }}</p>
      <h6 class="mb-1" style="font-size: 0.95rem"><em>{{ entry.publisher }}</em></h6>
      {% if entry.doi %}
        <p class="mb-0"><span>DOI:</span> <a href="https://doi.org/{{ entry.doi }}">{{ entry.doi }}</a></p>
      {% endif %}
    </li>
  {% endfor %}
  {% unless current_year == '' %}
    </ul>
  {% endunless %}
</div>

<style>
  .cv .cv-record-list .list-group-item {
    padding: 0.65rem 0;
  }

  .cv .cv-record-list .title {
    margin-top: 0;
    margin-bottom: 0.2rem;
    line-height: 1.25;
  }

  .cv .cv-record-list p {
    margin-bottom: 0.2rem;
    line-height: 1.35;
  }

  .cv .cv-record-list,
  .cv .cv-record-list .list-group-item,
  .cv .cv-record-list .title,
  .cv .cv-record-list p,
  .cv .cv-record-list em,
  .cv .cv-record-list a,
  .cv .cv-record-list span {
    font-weight: 300;
  }

  .cv .cv-record-list strong {
    font-weight: 700;
  }

  .cv .cv-publication-key {
    margin-bottom: 0.35rem;
  }

  .cv .cv-record-year {
    margin: 1.15rem 0 0.2rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--global-divider-color);
    font-size: 1rem;
    font-weight: 700;
  }

  .cv .cv-publication-key + .cv-record-years .cv-record-year:first-child {
    margin-top: 0.35rem;
  }
</style>
