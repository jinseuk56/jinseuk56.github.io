{% comment %}
  Site-specific CV publication renderer. The rendered CV keeps the complete author
  list, author-role markers, and the full DOI visible without duplicating a PDF-only
  citation format.
{% endcomment %}

<p class="cv-publication-key"><sup>†</sup> first or co-first author; <sup>*</sup> corresponding author.</p>
<ul class="card-text font-weight-light list-group list-group-flush cv-record-list">
  {% for entry in entries %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 col-sm-2 col-md-2 text-center">
          <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">
            {{ entry.releaseDate | default: entry.date | split: '-' | first }}
          </span>
        </div>
        <div class="col-xs-10 col-sm-10 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4">
            <a href="{{ entry.url }}">{{ entry.title }}</a>
          </h6>
          {% assign author_markup = entry.authors | replace: 'J. Ryu', '<strong>J. Ryu</strong>' | regex_replace: '([*†]+)', '<sup>\1</sup>' %}
          <p class="ml-1 ml-md-4 mb-1">{{ author_markup }}</p>
          <h6 class="ml-1 ml-md-4 mb-1" style="font-size: 0.95rem"><em>{{ entry.publisher }}</em></h6>
          {% if entry.doi %}
            <p class="ml-1 ml-md-4 mb-0"><span class="font-weight-bold">DOI:</span> <a href="https://doi.org/{{ entry.doi }}">{{ entry.doi }}</a></p>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>

<style>
  .cv .cv-record-list .list-group-item {
    padding-top: 0.55rem;
    padding-bottom: 0.55rem;
  }

  .cv .cv-record-list .title {
    margin-top: 0;
    margin-bottom: 0.2rem;
    line-height: 1.25;
  }

  .cv .cv-record-list p {
    margin-bottom: 0.2rem;
    line-height: 1.35;
  }

  .cv .cv-publication-key {
    margin-bottom: 0.35rem;
  }
</style>
