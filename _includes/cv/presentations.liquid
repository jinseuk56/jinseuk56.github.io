{% comment %} Presentations use the same compact, scan-friendly structure as publications. {% endcomment %}

<p class="cv-publication-key"><sup>†</sup> presenter or co-presenter; <sup>*</sup> corresponding author.</p>
{% assign current_year = '' %}
<div class="cv-record-years">
  {% for entry in entries %}
    {% assign entry_year = entry.date | split: '-' | first %}
    {% if entry_year != current_year %}
      {% unless current_year == '' %}
        </ul>
      {% endunless %}
      <h4 class="cv-record-year">{{ entry_year }}</h4>
      <ul class="card-text font-weight-light list-group list-group-flush cv-record-list">
      {% assign current_year = entry_year %}
    {% endif %}
    <li class="list-group-item">
      <h6 class="title font-weight-bold">
        {% if entry.url %}
          <a href="{{ entry.url }}">{{ entry.title }}</a>
        {% else %}
          {{ entry.title }}
        {% endif %}
      </h6>
      {% assign author_markup = entry.authors | replace: 'J. Ryu', '<strong>J. Ryu</strong>' | regex_replace: '([*†]+)', '<sup>\1</sup>' %}
      <p class="mb-1">{{ author_markup }}</p>
      <p class="mb-0"><em>{{ entry.type }}</em> · {{ entry.venue }}</p>
    </li>
  {% endfor %}
  {% unless current_year == '' %}
    </ul>
  {% endunless %}
</div>
